# ==========================================================================
# Next.js app (deployed to Vercel). Copy to `.env` for local dev, and set the
# same keys in the Vercel dashboard for production. NEVER commit `.env`.
# ==========================================================================

# ---- Database: single MySQL on obvi8, reached remotely from Vercel ---------
# Use a dedicated least-privilege DB user, require TLS, and keep the
# connection_limit low because serverless functions open many connections.
# Format: mysql://USER:PASSWORD@HOST:3306/tms_database?params
#   Local dev:  mysql://root:@localhost:3306/tms_database
#   Vercel:     reach the obvi8 MySQL via cPanel "Remote MySQL" (access host %),
#               a dedicated least-privilege user, TLS enforced, and a small pool
#               because serverless opens many connections.
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/tms_database?connection_limit=3&sslaccept=strict"

# ---- Auth: 32-byte random value used to sign/verify session JWTs -----------
SESSION_SECRET="CHANGE_ME_32_BYTE_RANDOM"

# ---- Stripe ----------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_or_live_..."

# ---- Mail (SMTP) -----------------------------------------------------------
MAIL_HOST="smtp.gmail.com"
MAIL_PORT="587"
MAIL_USER="ops.ankrahfl@gmail.com"
MAIL_PASS="GMAIL_APP_PASSWORD"          # rotate the one currently in plaintext
MAIL_FROM_NAME="Ankrah F&L"

# ---- Cross-app wiring (Next.js <-> PHP) ------------------------------------
# SERVER-side calls from Next.js route handlers to the PHP API (obvi8 domain).
PHP_API_BASE_URL="https://terminal.ankrahfl.com/api"

# SERVER-side base of the PHP marketing/site pages, used for Stripe
# success/cancel redirect URLs (see app/api/vehicles/send-quote/route.ts).
PHP_SITE_BASE_URL="https://terminal.ankrahfl.com"

# Optional: full-URL overrides for the vehicle-quote Stripe redirects. Leave
# unset to derive them from PHP_SITE_BASE_URL above.
# VEHICLE_PAYMENT_RETURN_URL="https://YOUR-OBVI8-DOMAIN/vehicle-payment-success.html?session_id={CHECKOUT_SESSION_ID}"
# VEHICLE_PAYMENT_CANCEL_URL="https://YOUR-OBVI8-DOMAIN/vehicle-quote.html#cancelled"

# BROWSER-side calls to the PHP API. Must be NEXT_PUBLIC_ to reach the client,
# and obvi8 CORS (ALLOWED_ORIGINS) must include the Vercel origin below.
NEXT_PUBLIC_PHP_API_BASE_URL="https://terminal.ankrahfl.com/api"

# BROWSER-side portal key sent with client fetches to the PHP pickup/rates API.
# WARNING: any NEXT_PUBLIC_ value is shipped to the browser and is NOT secret.
NEXT_PUBLIC_PICKUP_PORTAL_TOKEN="demo-local-token"

# Shared secret authenticating SERVER-to-server calls between the two apps.
# Both must equal SECURITY_GATEWAY_TOKEN on the PHP side. Keep server-only
# (do NOT prefix with NEXT_PUBLIC_).
PHP_SECURITY_GATEWAY_TOKEN="SHARED_TOKEN_MUST_MATCH_PHP"
SECURITY_GATEWAY_TOKEN="SHARED_TOKEN_MUST_MATCH_PHP"

# This app's own public URL on Vercel.
APP_BASE_URL="https://YOUR-APP.vercel.app"
